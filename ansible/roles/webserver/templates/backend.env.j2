# Ansible managed
MONGO_URI=mongodb://{{ mongo_app_user }}:{{ mongo_app_password }}@{{ hostvars['db-server'].private_ip }}:27017/{{ mongo_db_name }}?authSource={{ mongo_db_name }}
PORT={{ backend_port }}
NODE_ENV=production
# Frontend origin allowed to call the API (CORS) and number of proxies in front (Nginx)
CORS_ORIGIN=http://{{ ansible_host }}
TRUST_PROXY=1
