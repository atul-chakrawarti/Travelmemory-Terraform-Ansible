# Generated by Terraform (local_file.ansible_inventory) - do not edit by hand
[web]
web-server ansible_host=${web_public_ip} private_ip=${web_private_ip}

[db]
db-server ansible_host=${db_private_ip} private_ip=${db_private_ip}

[db:vars]
# The DB has no public IP, so Ansible jumps through the web server
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -i ${private_key_path} -o StrictHostKeyChecking=accept-new -W %h:%p -q ubuntu@${web_public_ip}"'

[web:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${private_key_path}
ansible_python_interpreter=/usr/bin/python3
